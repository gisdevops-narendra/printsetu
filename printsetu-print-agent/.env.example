# Preferred: run `npm run configure -- --agentId=... --agentSecret=...` instead,
# which writes agent.config.json. These env vars override that file if set.
PRINTSETU_AGENT_ID=
PRINTSETU_AGENT_SECRET=

PRINTSETU_BACKEND_WS_URL=ws://localhost:53000
PRINTSETU_BACKEND_HTTP_URL=http://localhost:53000/api
PRINTSETU_PRINTER_NAME=
PRINTSETU_POLL_INTERVAL_MS=8000
PRINTSETU_HEARTBEAT_INTERVAL_MS=20000
# windows | cups | mock — defaults to "windows" on win32, "cups" on Linux,
# "mock" everywhere else. Use "mock" for local dev without a real printer.
PRINTSETU_PRINT_DRIVER=
PRINTSETU_DOWNLOAD_DIR=
LOG_LEVEL=info
