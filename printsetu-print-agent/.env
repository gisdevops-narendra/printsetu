# See .env.example for descriptions. agentId/agentSecret come from agent.config.json.
# NOTE: 127.0.0.1, not localhost — on this machine "localhost" resolves to
# the IPv6 ::1 first, but the backend only binds IPv4 (BACKEND_HOST=0.0.0.0),
# and the socket.io-client XHR-polling transport doesn't fall back to IPv4,
# so it fails with "xhr poll error" against "localhost".
PRINTSETU_BACKEND_WS_URL=ws://127.0.0.1:53100
PRINTSETU_BACKEND_HTTP_URL=http://127.0.0.1:53100/api
# Left blank on purpose: pdf-to-printer falls back to "-print-to-default"
# when no printer name is given, i.e. whatever Windows' current default
# printer is at print time. That's dynamic across whatever printer is
# actually plugged in/set as default, instead of a name hardcoded here.
PRINTSETU_PRINTER_NAME=
PRINTSETU_POLL_INTERVAL_MS=8000
PRINTSETU_HEARTBEAT_INTERVAL_MS=20000
PRINTSETU_PRINT_DRIVER=windows
PRINTSETU_DOWNLOAD_DIR=
LOG_LEVEL=info
