# ============================================================
# PrintSetu — Local Environment Configuration
# Copy this file to .env and adjust if needed.
#
# NOTE on ports: this dev machine already had a lot of common ports busy
# (3000, 5432, 6379, 8080, 9000, 9001 were all taken by other local
# services), so PrintSetu's local stack intentionally uses a distinct,
# less-common port range below to avoid clashing with anything else
# running on your machine. Change them freely if they clash for you too.
# ============================================================

# ---------- General ----------
NODE_ENV=development
TZ=UTC

# ---------- PostgreSQL ----------
POSTGRES_USER=printsetu
POSTGRES_PASSWORD=printsetu_local_pw
POSTGRES_DB=printsetu_db
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
DATABASE_URL=postgresql://printsetu:printsetu_local_pw@localhost:55432/printsetu_db?schema=public

# ---------- Redis / BullMQ ----------
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_URL=redis://localhost:56379

# ---------- MinIO (S3-compatible; abstracted StorageService) ----------
# To swap to real AWS S3 later: point S3_ENDPOINT at nothing (unset) and
# set real AWS credentials/region — no application code changes needed,
# see printsetu-backend/src/storage/s3-storage.service.ts.
STORAGE_DRIVER=s3-minio
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=printsetu_minio
S3_SECRET_ACCESS_KEY=printsetu_minio_secret
S3_BUCKET=printsetu-documents
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001

# ---------- Keycloak ----------
KEYCLOAK_BASE_URL=http://localhost:58080
KEYCLOAK_PORT=58080
KEYCLOAK_REALM=printsetu
KEYCLOAK_FRONTEND_CLIENT_ID=printsetu-frontend
KEYCLOAK_BACKEND_ADMIN_CLIENT_ID=printsetu-backend-admin
KEYCLOAK_BACKEND_ADMIN_CLIENT_SECRET=printsetu_backend_admin_secret_dev_only
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# ---------- Backend (NestJS) ----------
BACKEND_PORT=53000
BACKEND_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:54200
STATUS_TOKEN_SECRET=change_this_dev_only_status_token_secret_please
AGENT_TOKEN_SECRET=change_this_dev_only_agent_token_secret_please
MAX_UPLOAD_SIZE_BYTES=26214400
DEFAULT_RETENTION_MINUTES=30
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=60

# ---------- Document analysis (Python / PyMuPDF) ----------
DOC_ANALYSIS_URL=http://localhost:58000
DOC_ANALYSIS_PORT=58000

# ---------- Frontend (Angular) ----------
FRONTEND_PORT=54200
API_BASE_URL=http://localhost:53000/api
PUBLIC_APP_BASE_URL=http://localhost:54200

# ---------- Print Agent ----------
AGENT_BACKEND_WS_URL=ws://localhost:53000
AGENT_BACKEND_HTTP_URL=http://localhost:53000/api
