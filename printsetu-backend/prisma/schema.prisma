// PrintSetu — Prisma schema
// Mirrors SRS Section 16 (Database Design) table-for-table.
// Tenant isolation: every operational table carries shop_id (directly or
// via a controlled FK path) and MUST be filtered by shop_id in every
// service-layer query — see backend/src/common/tenant/*.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

enum ShopStatus {
  ACTIVE
  INACTIVE
}

enum RoleName {
  ADMIN
  SHOPKEEPER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  ANALYSIS_FAILED
  PRINT_ELIGIBLE
  DELETED
}

// SRS 13.4: CREATED -> PRINT_ELIGIBLE -> QUEUED -> PRINTING -> PRINTED
// -> RETENTION_PENDING -> DELETED, with PRINT_FAILED / AGENT_OFFLINE /
// PRINT_UNKNOWN failure paths. Transitions are validated server-side only
// (see print-jobs/print-job-state-machine.ts).
enum PrintJobStatus {
  CREATED
  PRINT_ELIGIBLE
  QUEUED
  PRINTING
  PRINTED
  RETENTION_PENDING
  DELETED
  PRINT_FAILED
  AGENT_OFFLINE
  PRINT_UNKNOWN
  CANCELLED
}

enum PaperSize {
  A4
  A3
  LETTER
  LEGAL
}

enum ColorMode {
  BW
  COLOR
}

enum SideMode {
  SIMPLEX
  DUPLEX
}

enum QrStatus {
  ACTIVE
  REVOKED
}

enum PrinterStatus {
  ONLINE
  OFFLINE
  UNKNOWN
  // Soft-deleted: admin/shopkeeper removed the printer/agent link. Kept as
  // a status (not a row delete) because PrintJob.printerId has a real FK
  // to this table and historical jobs must keep pointing at it; REMOVED
  // printers are excluded from every listing, quota count and routing
  // decision (see PrintersService.remove / agent-credential.util.ts).
  REMOVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationEvent {
  UPLOAD_RECEIVED
  PRINT_QUEUED
  PRINT_COMPLETED
  PRINT_FAILED
  // Billing / subscription lifecycle
  SUBSCRIPTION_RENEWAL_REMINDER
  SUBSCRIPTION_PAYMENT_FAILED
  SUBSCRIPTION_GRACE_REMINDER
  SUBSCRIPTION_FINAL_WARNING
  SUBSCRIPTION_PAST_DUE
  SUBSCRIPTION_SUSPENDED
  SUBSCRIPTION_PAID
  SUBSCRIPTION_REACTIVATED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_TRIAL_ENDING
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAYMENT_PENDING
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  DAILY
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  OPEN
  PAID
  FAILED
  VOID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum InvoiceKind {
  INITIAL
  RENEWAL
  UPGRADE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  GATEWAY
  OTHER
}

// ------------------------------------------------------------------
// Core tenant tables
// ------------------------------------------------------------------

model Shop {
  id           String     @id @default(uuid())
  shopCode     String     @unique @map("shop_code")
  name         String
  ownerName    String     @map("owner_name")
  mobile       String
  email        String
  address      String
  city         String
  status       ShopStatus @default(ACTIVE)
  // Shop-owner-editable public profile (the fields above stay admin-managed).
  description  String?
  // Weekly opening hours: { mon: { open: boolean, from: "09:00", to: "18:00" }, ... }
  openingHours Json?      @map("opening_hours")
  // Object-storage keys for the logo / cover banner (served via signed URLs).
  logoKey      String?    @map("logo_key")
  bannerKey    String?    @map("banner_key")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  users              User[]
  printSessions      PrintSession[]
  documents          Document[]
  printJobs          PrintJob[]
  pricing            Pricing[]
  pricingTiers       PricingTier[]
  qrCodes            QrCode[]
  printers           Printer[]
  printSettings      PrintSettings?
  auditLogs          AuditLog[]
  notifications      Notification[]
  subscription       ShopSubscription?
  invoices           Invoice[]
  subscriptionEvents SubscriptionEvent[]

  @@map("shops")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?

  users User[]

  @@map("roles")
}

model User {
  id             String     @id @default(uuid())
  shopId         String?    @map("shop_id")
  roleId         String     @map("role_id")
  name           String
  mobile         String?
  email          String     @unique
  // Credentials are owned by Keycloak (SRS §18); this column exists only
  // to match the SRS's literal DB Design table and is never written to or
  // read for auth decisions by the application.
  passwordHash   String?    @map("password_hash")
  // Deliberate, scoped exception to the "Keycloak-only credentials" rule
  // above, requested by the product owner: admins need to view a shop
  // user's *current* password. Encrypted at rest (CredentialCipherService)
  // and holds a value only while it is still the one Keycloak has on
  // file — set on temp-password issuance, cleared the moment the user
  // changes it (mustChangePassword false). Never used for auth decisions;
  // Keycloak remains the sole authority there.
  currentPasswordEnc String?  @map("current_password_enc")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  keycloakUserId String?    @unique @map("keycloak_user_id")
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  shop Shop? @relation(fields: [shopId], references: [id])
  role Role  @relation(fields: [roleId], references: [id])

  auditLogs AuditLog[]

  @@index([shopId])
  @@map("users")
}

// ------------------------------------------------------------------
// Documents & print jobs
// ------------------------------------------------------------------

// Groups documents the customer uploads before a print job exists — created
// on first upload (client has no id yet) and reused for every subsequent
// upload in the same visit, so a page reload can recover "what did I
// already upload" via a session-scoped signed token (see StatusTokenClaims)
// instead of losing everything. Not itself shown to anyone — no token
// number lives here; that's still minted once, at PrintJob creation.
model PrintSession {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  createdAt DateTime @default(now()) @map("created_at")

  shop      Shop         @relation(fields: [shopId], references: [id])
  documents Document[]
  quotes    PrintQuote[]

  @@index([shopId])
  @@map("print_sessions")
}

model Document {
  id                       String         @id @default(uuid())
  shopId                   String         @map("shop_id")
  sessionId                String         @map("session_id")
  originalName             String         @map("original_name")
  s3Key                    String         @map("s3_key")
  mimeType                 String         @map("mime_type")
  sizeBytes                Int            @map("size_bytes")
  pageCount                Int?           @map("page_count")
  colorPages               Int?           @map("color_pages")
  colorDetectionConfidence String?        @map("color_detection_confidence") // "HIGH" | "LOW" | "UNKNOWN"
  status                   DocumentStatus @default(UPLOADED)
  uploadedAt               DateTime       @default(now()) @map("uploaded_at")
  deletedAt                DateTime?      @map("deleted_at")

  shop       Shop             @relation(fields: [shopId], references: [id])
  session    PrintSession     @relation(fields: [sessionId], references: [id])
  quoteItems PrintQuoteItem[]
  jobItems   PrintJobItem[]

  @@index([shopId])
  @@index([status])
  @@index([sessionId])
  @@map("documents")
}

// Price quotes computed by POST /api/print/quote. A quote covers every
// document the customer picked for this print request — one row per
// document (PrintQuoteItem), each with its OWN paper/color/side/copies and
// its own line-item price (per-document print options, not one shared
// setting for the whole batch) — summed into the quote's total `amount`.
// The quote snapshots the pricing rule in effect so confirming later
// (POST /api/print-jobs) never re-prices against a rule that may have
// changed (SRS §10).
model PrintQuote {
  id                 String    @id @default(uuid())
  sessionId          String    @map("session_id")
  amount             Decimal   @db.Decimal(10, 2)
  currency           String    @default("INR")
  statusTokenClaimId String    @unique @default(uuid()) @map("status_token_claim_id")
  expiresAt          DateTime  @map("expires_at")
  consumedAt         DateTime? @map("consumed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  session  PrintSession     @relation(fields: [sessionId], references: [id])
  items    PrintQuoteItem[]
  printJob PrintJob?

  @@index([sessionId])
  @@map("print_quotes")
}

model PrintQuoteItem {
  id              String    @id @default(uuid())
  quoteId         String    @map("quote_id")
  documentId      String    @map("document_id")
  paperSize       PaperSize
  colorMode       ColorMode
  sideMode        SideMode
  copies          Int
  pageCount       Int       @map("page_count")
  billablePages   Int       @map("billable_pages")
  amount          Decimal   @db.Decimal(10, 2)
  pricingSnapshot Json      @map("pricing_snapshot")

  quote    PrintQuote @relation(fields: [quoteId], references: [id])
  document Document   @relation(fields: [documentId], references: [id])

  @@index([quoteId])
  @@index([documentId])
  @@map("print_quote_items")
}

model PrintJob {
  id             String         @id @default(uuid())
  // Global, ever-increasing queue token (one sequence for the whole
  // deployment, never reset per shop/customer/day) — this is the ONLY
  // identifier surfaced to customers/shopkeepers/admins for tracing a
  // print request. `id` (uuid) remains internal-only: primary key, FK
  // target, and API path param, never shown or looked up by a human.
  // One PrintJob = one print request = one token, even though it can
  // cover several documents (PrintJobItem), each with its own options.
  tokenNumber    Int            @unique @default(autoincrement()) @map("token_number")
  shopId         String         @map("shop_id")
  printerId      String?        @map("printer_id")
  quoteId        String?        @unique @map("quote_id")
  amount         Decimal        @db.Decimal(10, 2)
  currency       String         @default("INR")
  status         PrintJobStatus @default(CREATED)
  attemptCount   Int            @default(0) @map("attempt_count")
  idempotencyKey String         @unique @map("idempotency_key")
  queuedAt       DateTime?      @map("queued_at")
  printedAt      DateTime?      @map("printed_at")
  failureReason  String?        @map("failure_reason")
  statusToken    String         @unique @map("status_token")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  shop    Shop           @relation(fields: [shopId], references: [id])
  printer Printer?       @relation(fields: [printerId], references: [id])
  quote   PrintQuote?    @relation(fields: [quoteId], references: [id])
  items   PrintJobItem[]

  events        PrintJobEvent[]
  notifications Notification[]

  @@index([shopId])
  @@index([status])
  @@map("print_jobs")
}

model PrintJobItem {
  id            String    @id @default(uuid())
  printJobId    String    @map("print_job_id")
  documentId    String    @map("document_id")
  paperSize     PaperSize
  colorMode     ColorMode
  sideMode      SideMode
  copies        Int
  pageCount     Int       @map("page_count")
  billablePages Int       @map("billable_pages")
  amount        Decimal   @db.Decimal(10, 2)
  // Order the agent should print documents in — stable regardless of
  // whatever order Prisma happens to return rows in.
  printOrder    Int       @map("print_order")
  // Shop-side editing (rotate/crop/brightness/contrast/sharpness), set via
  // PrintEditService. Null editState/renderedS3Key = unedited, print the
  // original Document.s3Key. The original is never overwritten — edits
  // always produce a new derived object so the pristine upload stays
  // recoverable.
  editState     Json?     @map("edit_state")
  renderedS3Key String?   @map("rendered_s3_key")
  renderedAt    DateTime? @map("rendered_at")

  printJob PrintJob @relation(fields: [printJobId], references: [id])
  document Document @relation(fields: [documentId], references: [id])

  @@index([printJobId])
  @@index([documentId])
  @@map("print_job_items")
}

// Append-only per-job transition log — backs the "timestamps + agent-side
// attempt ID" requirement in SRS §13.1 and the reconciliation flow for
// PRINT_UNKNOWN in §13.3/13.4.
model PrintJobEvent {
  id             String         @id @default(uuid())
  printJobId     String         @map("print_job_id")
  status         PrintJobStatus
  agentAttemptId String?        @map("agent_attempt_id")
  message        String?
  createdAt      DateTime       @default(now()) @map("created_at")

  printJob PrintJob @relation(fields: [printJobId], references: [id])

  @@index([printJobId])
  @@map("print_job_events")
}

model PrintSettings {
  id                     String   @id @default(uuid())
  shopId                 String   @unique @map("shop_id")
  defaultPrinterId       String?  @map("default_printer_id")
  retentionMinutes       Int      @default(30) @map("retention_minutes")
  maxFileSizeBytes       Int      @default(26214400) @map("max_file_size")
  // Admin-controlled, per-shop (off by default): lets the shopkeeper preview
  // a document before printing it, via a short-lived signed URL.
  documentPreviewEnabled Boolean  @default(false) @map("document_preview_enabled")
  // Shopkeeper-controlled (off by default): confirmed customer orders are sent
  // straight to the printer instead of waiting for the shopkeeper's PRINT tap.
  autoAcceptOrders       Boolean  @default(false) @map("auto_accept_orders")
  // Shopkeeper-controlled "Online / Offline" switch (on by default): when off,
  // customers who scan the QR see the shop as temporarily unavailable, e.g.
  // during a lunch break or a printer fault. Independent of the subscription.
  acceptingOrders        Boolean  @default(true) @map("accepting_orders")
  // Shopkeeper-controlled (off by default): go Online / Offline automatically
  // on the shop's opening hours (Shop.openingHours, in SHOP_TIME_ZONE).
  autoSchedule           Boolean   @default(false) @map("auto_schedule")
  // While autoSchedule is on, the header switch sets a temporary override
  // (true = online, false = offline) that lasts until the shopkeeper flips it
  // back or the next scheduled open/close, whichever comes first. null = none.
  scheduleOverride       Boolean?  @map("schedule_override")
  scheduleOverrideUntil  DateTime? @map("schedule_override_until")
  // In-portal alert preferences: { newOrderSound, desktopAlerts, failureAlerts }
  notificationPrefs      Json?    @map("notification_prefs")
  updatedAt              DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id])

  @@map("print_settings")
}

// Versioned/snapshotted pricing (SRS §10): historical orders keep the
// price rule that was active when their quote was generated.
model Pricing {
  id            String    @id @default(uuid())
  shopId        String    @map("shop_id")
  paperSize     PaperSize
  colorMode     ColorMode
  sideMode      SideMode
  pricePerPage  Decimal   @map("price_per_page") @db.Decimal(10, 2)
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id])

  @@unique([shopId, paperSize, colorMode, sideMode, effectiveFrom])
  @@index([shopId, active])
  @@map("pricing")
}

// Optional quantity-based rates on top of a combination's fixed Pricing rate.
// When a combination has active tiers, the order's total billable pages for
// that combination (pages x copies, summed across its documents) picks ONE
// tier and every page is charged at that tier's rate. No tiers, or a page
// count no tier covers, falls back to the fixed rate. Edits deactivate the
// old row and create a new one, same as Pricing.
model PricingTier {
  id           String    @id @default(uuid())
  shopId       String    @map("shop_id")
  paperSize    PaperSize
  colorMode    ColorMode
  sideMode     SideMode
  minPages     Int       @map("min_pages")
  // null = no upper bound ("21 pages and above")
  maxPages     Int?      @map("max_pages")
  pricePerPage Decimal   @map("price_per_page") @db.Decimal(10, 2)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId, active])
  @@map("pricing_tiers")
}

model QrCode {
  id          String    @id @default(uuid())
  shopId      String    @map("shop_id")
  publicCode  String    @unique @map("public_code")
  targetPath  String    @map("target_path")
  status      QrStatus  @default(ACTIVE)
  generatedAt DateTime  @default(now()) @map("generated_at")
  revokedAt   DateTime? @map("revoked_at")

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@map("qr_codes")
}

model Printer {
  id               String        @id @default(uuid())
  shopId           String        @map("shop_id")
  agentId          String        @unique @map("agent_id")
  agentKeyHash     String        @map("agent_key_hash")
  printerName      String        @map("printer_name")
  driverName       String?       @map("driver_name")
  // OS-level printer on the agent's computer that jobs are sent to, picked
  // by the shopkeeper from the agent-reported list in capabilitiesJson.
  // Null = let the agent use that computer's default printer.
  osPrinterName    String?       @map("os_printer_name")
  status           PrinterStatus @default(UNKNOWN)
  lastHeartbeatAt  DateTime?     @map("last_heartbeat_at")
  capabilitiesJson Json?         @map("capabilities_json")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  shop      Shop       @relation(fields: [shopId], references: [id])
  printJobs PrintJob[]

  @@index([shopId])
  @@map("printers")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?  @map("actor_user_id")
  shopId       String?  @map("shop_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  ip           String?
  userAgent    String?  @map("user_agent")
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])
  shop  Shop? @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Notification data model only (SRS §20): in-app is the implemented
// channel; EMAIL/SMS/WHATSAPP are modeled now so no schema change is
// needed to add real providers later.
model Notification {
  id          String              @id @default(uuid())
  shopId      String              @map("shop_id")
  printJobId  String?             @map("print_job_id")
  eventType   NotificationEvent   @map("event_type")
  channel     NotificationChannel @default(IN_APP)
  destination String?
  status      NotificationStatus  @default(PENDING)
  // Human-readable text for events not tied to a print job (billing).
  message     String?
  providerRef String?             @map("provider_ref")
  createdAt   DateTime            @default(now()) @map("created_at")

  shop     Shop      @relation(fields: [shopId], references: [id])
  printJob PrintJob? @relation(fields: [printJobId], references: [id])

  @@index([shopId])
  @@map("notifications")
}

model SystemSetting {
  key       String   @id
  valueJson Json     @map("value_json")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ------------------------------------------------------------------
// Subscriptions & billing
// ------------------------------------------------------------------

model SubscriptionPlan {
  id                String   @id @default(uuid())
  name              String   @unique
  description       String?
  dailyPrice        Decimal  @map("daily_price") @db.Decimal(10, 2)
  monthlyPrice      Decimal  @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice       Decimal  @map("yearly_price") @db.Decimal(10, 2)
  currency          String   @default("INR")
  trialDays         Int      @default(0) @map("trial_days")
  // Feature limits; null means unlimited.
  maxPrintsPerMonth Int?     @map("max_prints_per_month")
  maxTokensPerDay   Int?     @map("max_tokens_per_day")
  maxPrinters       Int?     @map("max_printers")
  prioritySupport   Boolean  @default(false) @map("priority_support")
  analyticsAccess   Boolean  @default(false) @map("analytics_access")
  // Free-text selling points shown on plan cards.
  highlights        String[]
  // Retire a plan without deleting the history that references it.
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  subscriptions ShopSubscription[]
  invoices      Invoice[]

  @@map("subscription_plans")
}

model ShopSubscription {
  id                   String             @id @default(uuid())
  shopId               String             @unique @map("shop_id")
  planId               String             @map("plan_id")
  cycle                BillingCycle       @default(MONTHLY)
  status               SubscriptionStatus @default(ACTIVE)
  startDate            DateTime           @default(now()) @map("start_date")
  currentPeriodStart   DateTime           @default(now()) @map("current_period_start")
  // The next billing / renewal date.
  currentPeriodEnd     DateTime           @map("current_period_end")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  graceEndsAt          DateTime?          @map("grace_ends_at")
  pastDueSince         DateTime?          @map("past_due_since")
  autoRenew            Boolean            @default(true) @map("auto_renew")
  // "MANUAL" = offline payments recorded by an admin; anything else is a gateway adapter.
  gateway              String             @default("MANUAL")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt          DateTime?          @map("cancelled_at")
  cancelReason         String?            @map("cancel_reason")
  // A scheduled plan change (downgrade at cycle end, or upgrade next cycle).
  pendingPlanId        String?            @map("pending_plan_id")
  pendingCycle         BillingCycle?      @map("pending_cycle")
  // Admin override: automation leaves the shop alone until released / expired.
  automationPaused     Boolean            @default(false) @map("automation_paused")
  pausedUntil          DateTime?          @map("paused_until")
  // null = use the platform default channels.
  notificationChannels Json?              @map("notification_channels")
  // Keys of reminders already sent, so each is sent once per period.
  remindersSent        Json               @default("[]") @map("reminders_sent")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  shop Shop             @relation(fields: [shopId], references: [id])
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([currentPeriodEnd])
  @@map("shop_subscriptions")
}

model Invoice {
  id               String         @id @default(uuid())
  number           String         @unique
  shopId           String         @map("shop_id")
  planId           String?        @map("plan_id")
  // Snapshot so old invoices keep reading correctly after plan edits.
  planName         String         @map("plan_name")
  cycle            BillingCycle
  kind             InvoiceKind    @default(RENEWAL)
  description      String
  periodStart      DateTime       @map("period_start")
  periodEnd        DateTime       @map("period_end")
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("INR")
  status           InvoiceStatus  @default(OPEN)
  dueDate          DateTime       @map("due_date")
  paidAt           DateTime?      @map("paid_at")
  paymentMethod    PaymentMethod? @map("payment_method")
  paymentReference String?        @map("payment_reference")
  attemptCount     Int            @default(0) @map("attempt_count")
  nextRetryAt      DateTime?      @map("next_retry_at")
  lastFailure      String?        @map("last_failure")
  refundedAmount   Decimal        @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  createdAt        DateTime       @default(now()) @map("created_at")

  shop    Shop              @relation(fields: [shopId], references: [id])
  plan    SubscriptionPlan? @relation(fields: [planId], references: [id])
  refunds Refund[]

  @@index([shopId, createdAt])
  @@index([status])
  @@map("invoices")
}

model Refund {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  amount      Decimal  @db.Decimal(10, 2)
  reason      String
  actorUserId String?  @map("actor_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("refunds")
}

// Per-shop subscription / billing audit trail: every plan change, status
// change and admin action, with who did it and why (actor null = system).
model SubscriptionEvent {
  id          String   @id @default(uuid())
  shopId      String   @map("shop_id")
  type        String
  fromValue   String?  @map("from_value")
  toValue     String?  @map("to_value")
  reason      String?
  actorUserId String?  @map("actor_user_id")
  actorName   String?  @map("actor_name")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId, createdAt])
  @@index([type, createdAt])
  @@map("subscription_events")
}
