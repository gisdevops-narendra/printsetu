# ============================================================
# PrintSetu — Production Environment (backend)
#
# Copy this file to printsetu-backend/.env.production and fill in real
# values (passwords, secrets, your domain/IP) before running:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Never commit the filled-in .env.production file — it's gitignored.
#
# NOTE on hostnames: unlike the dev .env (which uses localhost/LAN IP
# because backend/frontend run natively on the host), these point at
# Docker Compose service names, since backend now runs inside the same
# Docker network as postgres/redis/minio/keycloak/document-analysis.
#
# Public-facing values below are pre-filled with the production AWS
# Elastic IP (18.213.215.175). Swap to a domain name instead if/when one
# is pointed at it, and switch ws:// -> wss:// / http:// -> https://
# once TLS is added (see infra/README.md "Adding HTTPS").
# ============================================================

NODE_ENV=production
TZ=UTC

# ---------- PostgreSQL ----------
POSTGRES_USER=printsetu
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=printsetu_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://printsetu:CHANGE_ME_strong_password@postgres:5432/printsetu_db?schema=public

# ---------- Redis / BullMQ ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---------- MinIO (S3-compatible; abstracted StorageService) ----------
# S3_ENDPOINT is embedded into every presigned document preview/download
# URL handed straight to the BROWSER (see
# printsetu-backend/src/storage/s3-storage.service.ts), AND is what the
# backend itself connects to for its own uploads/reads — one shared
# client, one endpoint, so it can't point at "minio:9000" internally and
# something else externally. MinIO has no published port at all (not
# even 59000) — Nginx reverse proxies path-style requests to it
# internally instead (see infra/nginx/nginx.conf's
# "/printsetu-documents/" location), so this is just the public
# host with NO port suffix (goes through Nginx on :80). See
# infra/README.md for details.
STORAGE_DRIVER=s3-minio
S3_ENDPOINT=http://18.213.215.175
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=printsetu_minio
S3_SECRET_ACCESS_KEY=CHANGE_ME_strong_secret
S3_BUCKET=printsetu-documents
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300

# ---------- Keycloak (internal Docker network only — never exposed via Nginx) ----------
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=printsetu
KEYCLOAK_FRONTEND_CLIENT_ID=printsetu-frontend
KEYCLOAK_BACKEND_ADMIN_CLIENT_ID=printsetu-backend-admin
KEYCLOAK_BACKEND_ADMIN_CLIENT_SECRET=CHANGE_ME
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ---------- Backend (NestJS) ----------
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
# Browser calls now go through Nginx on the SAME origin as the frontend
# (relative /api/ — see printsetu-frontend/src/environments/environment.prod.ts),
# so this is mostly a safety net rather than something the browser
# actually needs cross-origin. Set it to your real origin anyway.
CORS_ALLOWED_ORIGINS=http://18.213.215.175
STATUS_TOKEN_SECRET=CHANGE_ME_random_secret
AGENT_TOKEN_SECRET=CHANGE_ME_random_secret
# 32-byte AES-256-GCM key (base64) used only to encrypt-at-rest the
# admin-visible "current password" copy. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_random_32_byte_base64_key
# Caps only the shop-side edited image re-uploads; customer uploads are unlimited.
MAX_UPLOAD_SIZE_BYTES=26214400
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=60

# ---------- Document analysis (Python / PyMuPDF) ----------
# Runs as its own internal-only Compose service — never published to the
# host or proxied by Nginx.
DOC_ANALYSIS_URL=http://document-analysis:8000

# ---------- Public URLs ----------
# Used server-side to build links shown to users (e.g. QR codes) — see
# printsetu-backend/src/qr/qr.service.ts.
PUBLIC_APP_BASE_URL=http://18.213.215.175

# ---------- Email (SMTP) ----------
# Registration verification codes, welcome emails and new-shop alerts.
# Use your provider's SMTP details (e.g. Amazon SES, SendGrid, Gmail/Workspace
# app password). SMTP_SECURE=true for port 465, false for 587 (STARTTLS).
# If SMTP_HOST is empty nothing is sent and shops cannot finish registering.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=narendrageo.gis@gmail.com
SMTP_PASSWORD=qrxsauvkjosnswbf
MAIL_FROM=PrintSetu <narendrageo.gis@gmail.com>
# Comma-separated; who is told about new shop registrations.
# Empty = every active admin account's email.
ADMIN_NOTIFICATION_EMAILS=narendrageo.gis@gmail.com

# ---------- Business Map (admin) ----------
# OpenStreetMap places for "coverage gaps" come from the Overpass API and are
# cached in the database for 14 days per ~11 km tile. The backend needs
# outbound internet access to reach it. Comma-separate several servers to
# rotate through them when one is busy. Leave unset for the public server.
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# ---------- Print Agent ----------
# Embedded into the downloadable Print Agent package the shopkeeper
# installs on their OWN PC, so these must be your public domain/IP, not a
# Docker service name. Switch ws:// -> wss:// and http:// -> https://
# once you've added TLS (see infra/README.md "Adding HTTPS").
AGENT_BACKEND_WS_URL=ws://18.213.215.175
AGENT_BACKEND_HTTP_URL=http://18.213.215.175/api

# Where the backend finds the Print Agent bundles that deploy.sh builds
# and docker-compose.prod.yml mounts. deploy.sh adds this line itself if
# it's missing, so you normally don't need to touch it. The Linux agent
# bundle is looked up at the same path + "-linux" (override with
# PRINT_AGENT_LINUX_BUNDLE_DIR).
PRINT_AGENT_BUNDLE_DIR=/app/agent-bundle
