# Dependencies (OS/arch-specific — always reinstall via npm install / pip install)
node_modules/

# Build output
dist/
.angular/
# Print Agent installer bundle — rebuilt fresh on every deploy by
# deploy.sh (see its "Building Print Agent installer bundle" step), so
# it's a throwaway build artifact now, not something to commit. Never
# byte-for-byte reproducible (pkg embeds build timestamps), so keeping it
# tracked meant every deploy left the working tree permanently dirty.
printsetu-print-agent/release/

# Python
.venv/
__pycache__/
*.pyc

# Logs
*.log

# Editor/OS
.DS_Store
Thumbs.db

# Production secrets (copied from *.env.production.example — never commit
# the filled-in file)
.env.production
*/.env.production

# Local production environment
.env
