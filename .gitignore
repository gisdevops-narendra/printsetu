# Dependencies (OS/arch-specific — always reinstall via npm install / pip install)
node_modules/

# Build output
dist/
.angular/
# ...except the assembled Print Agent bundle (release/bundle/) — that's a
# committed distributable the backend serves for shopkeeper download in
# production, not a throwaway build artifact. The loose intermediate exe
# next to it (release/PrintSetuAgent.exe) stays ignored.
printsetu-print-agent/release/*
!printsetu-print-agent/release/bundle/
!printsetu-print-agent/release/bundle/**

# Python
.venv/
__pycache__/
*.pyc

# Logs
*.log

# Editor/OS
.DS_Store
Thumbs.db

# Production secrets (copied from *.env.production.example — never commit
# the filled-in file)
.env.production
*/.env.production

# Local production environment
.env
